DROP DATABASE IF EXISTS car_repair;
CREATE DATABASE car_repair;
USE car_repair;
CREATE TABLE customer(
  idcustomer INT PRIMARY KEY AUTO_INCREMENT,
  cif VARCHAR(9) NOT NULL UNIQUE,
  namecus VARCHAR(45) NOT NULL,
  email VARCHAR(45),
  phone INT
);
CREATE TABLE vehicle(
  idvehicle VARCHAR(7) PRIMARY KEY,
  brand VARCHAR(45),
  model VARCHAR(45),
  inidate DATE
);

CREATE TABLE invoice(
  idinvoice INT PRIMARY KEY,
  releasedate DATE NOT NULL,
  payment ENUM('Outstanding', 'Credit card', 'Cash', 'Bizum', 'Check'),
  pricehour DECIMAL(6,2),
  idcustomer INT NOT NULL,
  idvehicle VARCHAR(7),
  FOREIGN KEY (idvehicle) REFERENCES vehicle(idvehicle),
  FOREIGN KEY (idcustomer) REFERENCES customer(idcustomer)
);

CREATE TABLE product (
  idproduct INT PRIMARY KEY AUTO_INCREMENT,
  descr VARCHAR(45) NOT NULL,
  price DECIMAL(8,2),
  stock INT
);

CREATE TABLE mechanic(
  idmechanic INT PRIMARY KEY AUTO_INCREMENT,
  cif VARCHAR(9) UNIQUE,
  namemec VARCHAR(45),
  email VARCHAR(45),
  phone INT
);

CREATE TABLE item_work(
  idinvoice INT,
  idmechanic INT,
  numhours DECIMAL(4,1),
  descr VARCHAR(45),
  FOREIGN KEY (idinvoice) REFERENCES invoice(idinvoice),
  FOREIGN KEY (idmechanic) REFERENCES mechanic(idmechanic),
  PRIMARY KEY (idinvoice, idmechanic)
);

CREATE TABLE item_prod(
  idinvoice INT,
  idproduct INT,
  price DECIMAL(8,2),
  units INT,
  FOREIGN KEY (idinvoice) REFERENCES invoice(idinvoice),
  FOREIGN KEY (idproduct) REFERENCES product(idproduct),
  PRIMARY KEY (idinvoice, idproduct)
);

