-- 13 suma de numeros de horas facturadas por el mecanico carlos sanchez

select sum(numhours) as sum_hours
from mechanic m join item_work iw on m.idmechanic = iw.idmechanic
where m.namemec like "sanchez %, Carlos";
-- 14 importe, iva y total de las horas facturadas por el mecanico Carlos sanchez

select sum(numhours * pricehour) as impor,
sum(iw.numhours * i.pricehour) *0.21 as vat,
sum(iw.numhours * i.pricehour) *1.21 as total
from mechanic m join item_work iw on m.idmechanic = iw.idmechanic
join invoice i on iw.idinvoice = i.idinvoice
where m.namemec like "sanchez %, Carlos";

-- 15 todos los datos de iten de productos que sean baterias

select *
from product p join item_prod ip on p.idproduct = ip.idproduct
where descr like "Battery%";

-- 16 de la consulta anterior, suma de unidades, suma de importe, suma de iva y suma de total

select sum(ip.units) as sum_units,
sum(ip.price * ip.units) as sum_imp,
sum(ip.price * ip.units) * 0.21 as sum_vat,
sum(ip.price * ip.units) * 1.21 as sum_tot
from product p join item_prod ip on p.idproduct = ip.idproduct
where descr like "Battery%";

-- 17 de la consulta anrterior, solo las ventas de 2026
select sum(ip.units) as sum_units,
sum(ip.price * ip.units) as sum_imp,
sum(ip.price * ip.units) * 0.21 as sum_vat,
sum(ip.price * ip.units) * 1.21 as sum_tot
from product p join item_prod ip on p.idproduct = ip.idproduct
join invoice i on i.idinvoice = ip.idinvoice
where descr like "Battery%" and year(releasedate) = 2026;

-- 18 todos los datos productos con una columna llamada category:
-- very cheap hasta 25€
-- cheap hasta 50€
-- medium hasta 75€
-- expensive hasta 100€
-- very expensive mas de 100€
-- solucion con la funcion if


-- 19 la consulta anterior, solucion con case
select *,
if (price <= 25, "very cheap",
if (price <= 50, "cheap",
if (price <= 75, "medium",
if (price <= 100, "expensive", "very expensive")
)
)
) as category
from product;

