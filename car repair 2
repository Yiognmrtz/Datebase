 -- 25 crea una copia de la tabla de productos, llamada product_back, con los diez primeros productos, para hacer pruebas de borrado y actualizacion
 
 create table product_back as
 select *
 from product
 where idproduct <= 10;
 
 -- 26 incrementa en 10 unidades el stock de todas las baterias
 
 update product_back
 set stock = stock +10
 where descr like "Battery %";
 
 -- 27 decrementa en un 10% el precio de los productos 2, 3, 4 y 6
 
 update product_back
 set price = price * 0.90
 where idproduct in (2, 3, 4, 6);
 
 -- 28 borra las filas desde la 6 en adelante 
 
 delete from product_back
 where idproduct >= 6;
 
 -- 29 inserta un nuevo producto inventado
 
 insert into product_back(idproduct, descr, price, stock)
 values (6, "Battery 100A",  125, 1);
 
 -- 30 concatenar una letra h minuscula al final de la descripcion de las baterias
 update product_back
 set descr = concat(descr, "h")
 where descr like "Battery %";
 
 -- 31 inserta los productos del 7 en adelante desde la tabla "product"
 insert into product_back
 select *
 from product
 where idproduct >= 7;
 
