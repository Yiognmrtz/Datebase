from customer c join invoice i on c.idcustomer = i.idcustomer
where c.namecus like "Torres %, Elena" and i.payment = "bizum"  ;


-- 5 equijoin de facturas e items de productos

select * 
from invoice i join item_prod ip on i.idinvoice = ip.idinvoice;

-- 6 suma de importe de productos e iva (21%) de las facturas del año 2025

select sum(ip.price * ip.units) as sum_import,
round(sum(ip.price *ip.units) * 0.21,2) as sum_vat
from invoice i join item_prod ip on i.idinvoice = ip.idinvoice
where year (i.releasedate) = 2025;

-- 7 cuantas facturas hay en total, cuantas en 2025 y cuantas en 2026

select count(*) as count_all,
sum(year(releasedate)=2025)as count_2025,
sum(year(releasedate)=2026)as count_2026
from invoice;

-- 8 incremento en tanto por ciento del numero de facturas entre 2024 y 2025

select 
(sum(year(releasedate)=2025) -
sum(year(releasedate)=2024))
/ sum(year(releasedate)=2024)*100 as increase
from invoice;

-- 9 equijoin de facturas e items de mano de obra 

select *
from invoice i join item_work iw on i.idinvoice = iw.idinvoice;

-- 10 suma e importe, iva y total de la mano de de obra del 2025

select sum(i.pricehour * iw.numhours) as sum_import,
round(sum(i.pricehour* iw.numhours)*0.21, 2) as sum_vat,
round(sum(i.pricehour* iw.numhours)*1.21, 2) as sum_tot
from invoice i join item_work iw on i.idinvoice = iw.idinvoice
where year (i.releasedate)= 2025;

