-- 1  todas los datos de las facturas de 2025 y 2026
select *
from invoice
where year (releasedate) in (2025, 2026);

-- 2. lo mismo con el operador between
select *
from invoice
where releasedate between '2025-01-01' and '2026-12-31';

-- 3. equijoin de clientes y facturas
select *
from customer c join invoice i on c.idcustomer = i.idcustomer;

-- 4 las facturas de elena torres pagadas con bizum

